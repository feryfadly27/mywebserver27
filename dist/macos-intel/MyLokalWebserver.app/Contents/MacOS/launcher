#!/bin/bash
# ⚡ MyLokalWebserver - Launcher for macOS & Linux

# Navigate to script directory
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
cd "$DIR"

# Ensure binary has execute permission
chmod +x ./mylokalwebserver 2>/dev/null

echo "=================================================="
echo "  ⚡ Starting MyLokalWebserver..."
echo "  📁 Working directory: $DIR"
echo "=================================================="

# Run binary
./mylokalwebserver "$@"
